# /etc/uogradnet/secrets.env  -- NEVER commit the real file.
#
# Copy this to /etc/uogradnet/secrets.env on the server (mode 600, owner root),
# fill in every value, then run `sudo make deploy`. Values are taken literally:
# no quotes, everything after the first '=' is the value.

# Contact address shown in /ADMIN and on ban messages; also used for Let's Encrypt.
ADMIN_EMAIL=admin@uogradnet.xyz

# UnrealIRCd operator password HASH (not the password). Generate with:
#   sudo -u unrealircd ~unrealircd/unrealircd/unrealircd mkpasswd
OPER_PASSWORD_HASH=$argon2id$v=19$m=6144,t=2,p=2$REPLACE_ME

# Three random cloak keys. Generate with:
#   sudo -u unrealircd ~unrealircd/unrealircd/unrealircd gencloak
CLOAK_KEY_1=REPLACE_ME
CLOAK_KEY_2=REPLACE_ME
CLOAK_KEY_3=REPLACE_ME

# Shared password between UnrealIRCd and Atheme. Any long random string:
#   openssl rand -hex 24
SERVICES_LINK_PASSWORD=REPLACE_ME

# Your NickServ account name; it gets full services-admin (SRA) rights.
SERVICES_ADMIN_ACCOUNT=yournick

# Password of the chatlog bot's NickServ account (see README, "First boot").
CHATLOG_PASSWORD=REPLACE_ME

# Registration emails are sent through Proton Mail SMTP from this address.
# It must be an address on a custom domain in your Proton account, e.g.
# noreply@uogradnet.xyz. The token: Proton Settings -> IMAP/SMTP -> SMTP tokens.
MAIL_FROM=noreply@uogradnet.xyz
SMTP_TOKEN=REPLACE_ME
