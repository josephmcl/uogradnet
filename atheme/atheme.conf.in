/*
 * Atheme 7.2 services for UOGradNet: NickServ, ChanServ, SaslServ,
 * OperServ, Global and ALIS (channel directory).
 *
 * Registration needs an email address in allowmail_domains (below) or on
 * the ALLOWMAIL list, and stays unverified until the emailed code is
 * sent back (auth = email). See allowmail.c.
 *
 * Template: `make deploy` fills in the @-wrapped placeholders from /etc/uogradnet/secrets.env
 * and installs it as /etc/atheme/atheme.conf. The account/channel database
 * lives in /var/lib/atheme/services.db (not in git: it holds password hashes).
 */

loadmodule "modules/protocol/unreal4";
loadmodule "modules/backend/opensex";
loadmodule "modules/crypto/pbkdf2v2";

loadmodule "modules/nickserv/main";
loadmodule "modules/nickserv/drop";
loadmodule "modules/nickserv/freeze";
loadmodule "modules/nickserv/ghost";
loadmodule "modules/nickserv/group";
loadmodule "modules/nickserv/help";
loadmodule "modules/nickserv/hold";
loadmodule "modules/nickserv/identify";
loadmodule "modules/nickserv/info";
loadmodule "modules/nickserv/listmail";
loadmodule "modules/nickserv/logout";
loadmodule "modules/nickserv/register";
loadmodule "modules/nickserv/regnolimit";
loadmodule "modules/nickserv/return";
loadmodule "modules/nickserv/set_core";
loadmodule "modules/nickserv/set_email";
loadmodule "modules/nickserv/set_hidemail";
loadmodule "modules/nickserv/set_password";
loadmodule "modules/nickserv/setpass";
loadmodule "modules/nickserv/sendpass_user";
loadmodule "modules/nickserv/verify";
loadmodule "modules/nickserv/allowmail";
loadmodule "modules/nickserv/status";
loadmodule "modules/nickserv/taxonomy";
loadmodule "modules/nickserv/vhost";

loadmodule "modules/chanserv/main";
loadmodule "modules/chanserv/access";
loadmodule "modules/chanserv/akick";
loadmodule "modules/chanserv/ban";
loadmodule "modules/chanserv/drop";
loadmodule "modules/chanserv/flags";
loadmodule "modules/chanserv/help";
loadmodule "modules/chanserv/info";
loadmodule "modules/chanserv/invite";
loadmodule "modules/chanserv/kick";
loadmodule "modules/chanserv/list";
loadmodule "modules/chanserv/op";
loadmodule "modules/chanserv/recover";
loadmodule "modules/chanserv/register";
loadmodule "modules/chanserv/set_core";
loadmodule "modules/chanserv/set_entrymsg";
loadmodule "modules/chanserv/set_guard";
loadmodule "modules/chanserv/set_keeptopic";
loadmodule "modules/chanserv/set_mlock";
loadmodule "modules/chanserv/set_restricted";
loadmodule "modules/chanserv/set_url";
loadmodule "modules/chanserv/status";
loadmodule "modules/chanserv/sync";
loadmodule "modules/chanserv/taxonomy";
loadmodule "modules/chanserv/template";
loadmodule "modules/chanserv/topic";
loadmodule "modules/chanserv/voice";
loadmodule "modules/chanserv/why";

loadmodule "modules/operserv/main";
loadmodule "modules/operserv/akill";
loadmodule "modules/operserv/help";
loadmodule "modules/operserv/info";
loadmodule "modules/operserv/mode";
loadmodule "modules/operserv/rehash";
loadmodule "modules/operserv/uptime";

loadmodule "modules/saslserv/main";
loadmodule "modules/saslserv/plain";
loadmodule "modules/global/main";
loadmodule "modules/alis/main";

serverinfo {
	name = "services.uogradnet.xyz";
	desc = "UOGradNet Services";
	numeric = "00A";
	recontime = 10;
	netname = "UOGradNet";
	hidehostsuffix = "users.uogradnet.xyz";
	adminname = "UOGradNet admins";
	adminemail = "@ADMIN_EMAIL@";
	registeremail = "@MAIL_FROM@";   /* must be the SMTP account's address */
	mta = "/usr/bin/msmtp";          /* configured in /etc/msmtprc */
	loglevel = { error; info; admin; network; };
	maxlogins = 5;
	maxusers = 5;
	mdlimit = 30;
	emaillimit = 10;
	emailtime = 300;
	auth = email;
	casemapping = ascii;
};

uplink "irc.uogradnet.xyz" {
	host = "127.0.0.1";
	password = "@SERVICES_LINK_PASSWORD@";
	port = 6900;
};

nickserv {
	nick = "NickServ"; user = "NickServ"; host = "services.uogradnet.xyz";
	real = "Nickname Services";
	aliases { "ID" = "IDENTIFY"; "MYACCESS" = "LISTCHANS"; };
	maxnicks = 5;
	expire = 0;                      /* accounts never expire */
	allowmail_domains = "uoregon.edu uogradnet.xyz";
};

chanserv {
	nick = "ChanServ"; user = "ChanServ"; host = "services.uogradnet.xyz";
	real = "Channel Services";
	maxchans = 10;
	fantasy;
	templates {
		vop = "+AV";
		hop = "+AHehitrv";
		aop = "+AOehiortv";
		sop = "+AOaefhiorstv";
		founder = "+AFORaefhiorstv";
	};
	trigger = "!";
	expire = 0;
	maxchanacs = 0;
	maxfounders = 4;
};

global   { nick = "Global";   user = "Global";   host = "services.uogradnet.xyz"; real = "Network Announcements"; };
operserv { nick = "OperServ"; user = "OperServ"; host = "services.uogradnet.xyz"; real = "Operator Services"; };
saslserv { nick = "SaslServ"; user = "SaslServ"; host = "services.uogradnet.xyz"; real = "SASL Authentication Agent"; };
alis     { nick = "ALIS";     user = "alis";     host = "services.uogradnet.xyz"; real = "Channel Directory"; };

logfile "/var/log/atheme/account.log"  { register; set; };
/* Every registration, verification, email change and admin action, with
 * the email address, posted to #admins (a channel only admins can stay in;
 * see README, "First boot"), so admins see who joins. A REGISTER line
 * with no VERIFY after it usually means the email never arrived. */
logfile "#admins" { register; set; admin; };
logfile "/var/log/atheme/commands.log" { commands; };
logfile "!snotices" { error; info; request; denycmd; };

general {
	join_chans;
	leave_chans;
	uflags = { hidemail; };
	cflags = { verbose; guard; };
	flood_msgs = 7;
	flood_time = 10;
	ratelimit_uses = 5;
	ratelimit_period = 60;
	kline_time = 7;
	commit_interval = 5;
	language = "en";
	immune_level = immune;
};

operclass "ircop" {
	privs { special:ircop; };
	privs { user:auspex; user:admin; user:vhost; user:mark; };
	privs { chan:auspex; chan:admin; chan:cmodes; chan:joinstaffonly; };
	privs { general:auspex; general:helper; general:viewprivs; general:flood; };
	privs { operserv:omode; operserv:akill; operserv:global; };
};

operclass "sra" {
	extends "ircop";
	privs { user:hold; user:regnolimit; };
	privs { general:metadata; general:admin; };
	privs { operserv:noop; operserv:grant; };
	needoper;
};

operator "@SERVICES_ADMIN_ACCOUNT@" { operclass = "sra"; };
